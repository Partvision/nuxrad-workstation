{
  "format": "nuxrad-jss-theme/v1",
  "id": "ember",
  "name": "Ember",
  "version": "2.0.0",
  "colors": [
    "#17110d",
    "#261d17",
    "#35291f",
    "#594433",
    "#f1bd77",
    "#f4e7d8",
    "#c6ad94"
  ],
  "profile": {
    "rail": 148,
    "header": 52,
    "radius": 1,
    "control": 36,
    "font": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
    "label": "Dense squared instruments",
    "surface": "outlined",
    "weight": 650
  },
  "settings": {
    "scale": 100,
    "density": "theme",
    "corners": "theme",
    "navigation": "theme",
    "font": "theme",
    "motion": "system",
    "contrast": "normal",
    "reflectivityPalette": "keep",
    "velocityPalette": "keep"
  },
  "jss": {
    "&": {
      "--ui-header-height": "52px",
      "--ui-radius": "0.5px",
      "--radius-control": "1px",
      "--font-sans": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
      "--nxpro-rail-width": "148px",
      "fontSize": 14
    },
    "& body, & #__nuxt": {
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif"
    },
    "& [data-app-navbar]": {
      "borderBottom": "2px solid var(--nxpro-line)",
      "boxShadow": "none",
      "background": "var(--nxpro-panel)",
      "backdropFilter": "none"
    },
    "& [data-app-navbar] [data-slot=\"root\"]": {
      "minHeight": 52
    },
    "& #dashboard-sidebar-toolbox[data-collapsed=\"true\"]": {
      "width": 148,
      "minWidth": 148
    },
    "& .nxpro-rail": {
      "width": 148,
      "minWidth": 148,
      "maxWidth": 148,
      "padding": "22px 12px 12px",
      "gap": 5,
      "borderRight": "1px solid var(--nxpro-line)",
      "background": "var(--nxpro-panel)"
    },
    "& .nxpro-rail button": {
      "width": 124,
      "minWidth": 124,
      "minHeight": 36,
      "borderRadius": 1,
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
      "fontWeight": 650,
      "flexDirection": "row",
      "justifyContent": "flex-start",
      "gap": 12,
      "padding": "10px 12px",
      "fontSize": 12
    },
    "& .nxpro-rail button [class*=\"text-\"]": {
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
      "fontSize": 12,
      "lineHeight": 1.3
    },
    "& .nxpro-rail::before": {
      "content": "\"WORKSPACE\"",
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
      "fontSize": 9,
      "padding": "0 12px 12px",
      "letterSpacing": ".18em"
    },
    "& .nxpro-rail .nxm-entry-label": {
      "fontSize": 9,
      "padding": "0 12px 12px",
      "textAlign": "left"
    },
    "& .nxpro-rail .nxm-entry-button": {
      "flexDirection": "row"
    },
    "& .nxpro-rail .nxm-entry-button span": {
      "fontSize": 12
    },
    "& .nxpro-right-rail button": {
      "borderRadius": 1,
      "minHeight": 42,
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif"
    },
    "& #dashboard-panel-home": {
      "padding": "4px 4px 4px"
    },
    "& #dashboard-panel-home > [data-slot=\"body\"]": {
      "borderRadius": 1,
      "boxShadow": "0 0 0 1px var(--nxpro-line)"
    },
    "& .nxpro-pane-label": {
      "borderRadius": 1,
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
      "fontSize": 12,
      "minHeight": 28,
      "boxShadow": "none",
      "border": "1px solid var(--nxpro-line)",
      "letterSpacing": ".04em"
    },
    "& .nxpro-timeline": {
      "borderRadius": 1,
      "padding": "9px 12px",
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
      "boxShadow": "none",
      "backdropFilter": "none"
    },
    "& [data-app-navbar] button, & [data-slot=\"header\"] button": {
      "borderRadius": 1,
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif"
    },
    "& [data-slot=\"title\"]": {
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif",
      "fontWeight": 650,
      "letterSpacing": ".05em"
    },
    "& [role=\"dialog\"][data-slot=\"content\"], & [role=\"menu\"], & [role=\"listbox\"]": {
      "borderRadius": 3,
      "border": "1px solid var(--nxpro-line)",
      "boxShadow": "none",
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif"
    },
    "& input:not([type=\"range\"]):not([type=\"checkbox\"]):not([type=\"radio\"]), & select, & textarea": {
      "borderRadius": 1,
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif"
    },
    "& .nxm-dialog, & .nxm-card, & .nxm-notes": {
      "borderRadius": 5,
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif"
    },
    "& .nxm-button, & .nxm-filter, & .nxm-search, & .nxm-dock-button": {
      "borderRadius": 1,
      "fontFamily": "\"Bahnschrift\",\"Segoe UI\",sans-serif"
    },
    "& .nxm-dialog": {
      "left": 160,
      "top": 68
    },
    "@media (max-width: 1000px)": {
      "& #dashboard-sidebar-toolbox[data-collapsed=\"true\"], & .nxpro-rail": {
        "width": 76,
        "minWidth": 76,
        "maxWidth": 76
      },
      "& .nxpro-rail": {
        "padding": "12px 6px"
      },
      "& .nxpro-rail button": {
        "width": 64,
        "minWidth": 64,
        "flexDirection": "column",
        "justifyContent": "center",
        "gap": 4
      },
      "& .nxpro-rail button [class*=\"text-\"]": {
        "fontSize": 10
      },
      "& .nxm-dialog": {
        "left": 88
      }
    },
    "@media (max-width: 750px)": {
      "& .nxm-dialog": {
        "left": 12,
        "top": 15
      }
    }
  },
  "palettes": {
    "BR": "; High Contrast — NUXRAD theme bundle\nProduct: BR\nUnits: dBZ\nScale: 1\nOffset: 0\n\nColor4: -20 0 0 0 0\nColor4: 0 70 90 110 45\nColor4: 15 70 130 150 160\nColor4: 20 0 255 100 255\nColor4: 30 0 150 50 255\nColor4: 35 255 255 0 255\nColor4: 45 255 130 0 255\nColor4: 50 255 35 35 255\nColor4: 60 255 0 220 255\nColor4: 70 255 255 255 255\nColor4: 80 80 215 255 255\n",
    "BV": "; Classic Radar — NUXRAD theme bundle\nProduct: BV\nUnits: m/s\nScale: 1\nOffset: 0\n\nColor4: -64 0 255 80 255\nColor4: -40 0 160 40 255\nColor4: -20 0 100 60 255\nColor4: -5 120 210 170 255\nColor4: 0 200 200 200 255\nColor4: 5 245 170 120 255\nColor4: 20 200 55 0 255\nColor4: 40 170 0 0 255\nColor4: 64 255 50 40 255\n"
  }
}