{
  "format": "nuxrad-jss-theme/v1",
  "id": "aurora",
  "name": "Aurora",
  "version": "2.0.0",
  "colors": [
    "#081410",
    "#10251d",
    "#1a352a",
    "#2c5141",
    "#7ce7b7",
    "#e0f4e9",
    "#a2c5b4"
  ],
  "profile": {
    "rail": 184,
    "header": 72,
    "radius": 16,
    "control": 50,
    "font": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
    "label": "Spacious pill controls",
    "surface": "soft",
    "weight": 600
  },
  "settings": {
    "scale": 100,
    "density": "theme",
    "corners": "theme",
    "navigation": "theme",
    "font": "theme",
    "motion": "system",
    "contrast": "normal",
    "reflectivityPalette": "keep",
    "velocityPalette": "keep"
  },
  "jss": {
    "&": {
      "--ui-header-height": "72px",
      "--ui-radius": "8px",
      "--radius-control": "16px",
      "--font-sans": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
      "--nxpro-rail-width": "184px",
      "fontSize": 14
    },
    "& body, & #__nuxt": {
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif"
    },
    "& [data-app-navbar]": {
      "borderBottom": "1px solid var(--nxpro-line)",
      "boxShadow": "0 3px 16px #0002",
      "background": "var(--nxpro-panel)",
      "backdropFilter": "none"
    },
    "& [data-app-navbar] [data-slot=\"root\"]": {
      "minHeight": 72
    },
    "& #dashboard-sidebar-toolbox[data-collapsed=\"true\"]": {
      "width": 184,
      "minWidth": 184
    },
    "& .nxpro-rail": {
      "width": 184,
      "minWidth": 184,
      "maxWidth": 184,
      "padding": "22px 12px 12px",
      "gap": 9,
      "borderRight": "1px solid var(--nxpro-line)",
      "background": "var(--nxpro-panel)"
    },
    "& .nxpro-rail button": {
      "width": 160,
      "minWidth": 160,
      "minHeight": 50,
      "borderRadius": 16,
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
      "fontWeight": 600,
      "flexDirection": "row",
      "justifyContent": "flex-start",
      "gap": 12,
      "padding": "10px 12px",
      "fontSize": 12
    },
    "& .nxpro-rail button [class*=\"text-\"]": {
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
      "fontSize": 12,
      "lineHeight": 1.3
    },
    "& .nxpro-rail::before": {
      "content": "\"WORKSPACE\"",
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
      "fontSize": 9,
      "padding": "0 12px 12px",
      "letterSpacing": ".12em"
    },
    "& .nxpro-rail .nxm-entry-label": {
      "fontSize": 9,
      "padding": "0 12px 12px",
      "textAlign": "left"
    },
    "& .nxpro-rail .nxm-entry-button": {
      "flexDirection": "row"
    },
    "& .nxpro-rail .nxm-entry-button span": {
      "fontSize": 12
    },
    "& .nxpro-right-rail button": {
      "borderRadius": 16,
      "minHeight": 56,
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif"
    },
    "& #dashboard-panel-home": {
      "padding": "10px 10px 8px"
    },
    "& #dashboard-panel-home > [data-slot=\"body\"]": {
      "borderRadius": 16,
      "boxShadow": "0 0 0 1px var(--nxpro-line),0 7px 24px #0002"
    },
    "& .nxpro-pane-label": {
      "borderRadius": 16,
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
      "fontSize": 12,
      "minHeight": 40,
      "boxShadow": "0 7px 24px #0002",
      "border": "1px solid var(--nxpro-line)",
      "letterSpacing": ".01em"
    },
    "& .nxpro-timeline": {
      "borderRadius": 16,
      "padding": "9px 12px",
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
      "boxShadow": "0 7px 24px #0002",
      "backdropFilter": "none"
    },
    "& [data-app-navbar] button, & [data-slot=\"header\"] button": {
      "borderRadius": 16,
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif"
    },
    "& [data-slot=\"title\"]": {
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif",
      "fontWeight": 600,
      "letterSpacing": "-.01em"
    },
    "& [role=\"dialog\"][data-slot=\"content\"], & [role=\"menu\"], & [role=\"listbox\"]": {
      "borderRadius": 18,
      "border": "1px solid var(--nxpro-line)",
      "boxShadow": "0 7px 24px #0002",
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif"
    },
    "& input:not([type=\"range\"]):not([type=\"checkbox\"]):not([type=\"radio\"]), & select, & textarea": {
      "borderRadius": 16,
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif"
    },
    "& .nxm-dialog, & .nxm-card, & .nxm-notes": {
      "borderRadius": 20,
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif"
    },
    "& .nxm-button, & .nxm-filter, & .nxm-search, & .nxm-dock-button": {
      "borderRadius": 16,
      "fontFamily": "\"Segoe UI Variable Text\",\"Segoe UI\",sans-serif"
    },
    "& .nxm-dialog": {
      "left": 196,
      "top": 88
    },
    "@media (max-width: 1000px)": {
      "& #dashboard-sidebar-toolbox[data-collapsed=\"true\"], & .nxpro-rail": {
        "width": 76,
        "minWidth": 76,
        "maxWidth": 76
      },
      "& .nxpro-rail": {
        "padding": "12px 6px"
      },
      "& .nxpro-rail button": {
        "width": 64,
        "minWidth": 64,
        "flexDirection": "column",
        "justifyContent": "center",
        "gap": 4
      },
      "& .nxpro-rail button [class*=\"text-\"]": {
        "fontSize": 10
      },
      "& .nxm-dialog": {
        "left": 88
      }
    },
    "@media (max-width: 750px)": {
      "& .nxm-dialog": {
        "left": 12,
        "top": 15
      }
    }
  },
  "palettes": {
    "BR": "; Teal & Amber — NUXRAD theme bundle\nProduct: BR\nUnits: dBZ\nScale: 1\nOffset: 0\n\nColor4: -20 0 0 0 0\nColor4: 0 70 85 100 45\nColor4: 10 65 115 155 130\nColor4: 20 20 155 190 255\nColor4: 30 70 205 205 255\nColor4: 35 230 220 120 255\nColor4: 45 255 170 50 255\nColor4: 50 230 95 35 255\nColor4: 60 180 55 135 255\nColor4: 70 235 200 245 255\nColor4: 80 255 255 255 255\n",
    "BV": "; Teal & Amber — NUXRAD theme bundle\nProduct: BV\nUnits: m/s\nScale: 1\nOffset: 0\n\nColor4: -64 180 255 255 255\nColor4: -40 30 205 220 255\nColor4: -20 0 125 155 255\nColor4: -5 70 100 115 255\nColor4: 0 170 175 180 255\nColor4: 5 125 100 65 255\nColor4: 20 220 145 30 255\nColor4: 40 255 195 65 255\nColor4: 64 255 245 180 255\n"
  }
}