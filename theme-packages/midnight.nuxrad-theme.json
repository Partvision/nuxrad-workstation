{
  "format": "nuxrad-jss-theme/v1",
  "id": "midnight",
  "name": "Midnight",
  "version": "2.0.0",
  "colors": [
    "#060c1b",
    "#0d1730",
    "#172441",
    "#2a3d64",
    "#80acff",
    "#e0e9ff",
    "#9aafd2"
  ],
  "profile": {
    "rail": 76,
    "header": 50,
    "radius": 4,
    "control": 38,
    "font": "\"Cascadia Code\",\"Consolas\",monospace",
    "label": "Compact icon rail",
    "surface": "outlined",
    "weight": 500
  },
  "settings": {
    "scale": 100,
    "density": "theme",
    "corners": "theme",
    "navigation": "theme",
    "font": "theme",
    "motion": "system",
    "contrast": "normal",
    "reflectivityPalette": "keep",
    "velocityPalette": "keep"
  },
  "jss": {
    "&": {
      "--ui-header-height": "50px",
      "--ui-radius": "2px",
      "--radius-control": "4px",
      "--font-sans": "\"Cascadia Code\",\"Consolas\",monospace",
      "--nxpro-rail-width": "76px",
      "fontSize": 14
    },
    "& body, & #__nuxt": {
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace"
    },
    "& [data-app-navbar]": {
      "borderBottom": "2px solid var(--nxpro-line)",
      "boxShadow": "none",
      "background": "var(--nxpro-panel)",
      "backdropFilter": "none"
    },
    "& [data-app-navbar] [data-slot=\"root\"]": {
      "minHeight": 50
    },
    "& #dashboard-sidebar-toolbox[data-collapsed=\"true\"]": {
      "width": 76,
      "minWidth": 76
    },
    "& .nxpro-rail": {
      "width": 76,
      "minWidth": 76,
      "maxWidth": 76,
      "padding": "16px 6px 12px",
      "gap": 5,
      "borderRight": "1px solid var(--nxpro-line)",
      "background": "var(--nxpro-panel)"
    },
    "& .nxpro-rail button": {
      "width": 64,
      "minWidth": 64,
      "minHeight": 38,
      "borderRadius": 4,
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace",
      "fontWeight": 500,
      "flexDirection": "column",
      "justifyContent": "center",
      "gap": 5,
      "padding": "7px 4px",
      "fontSize": 10
    },
    "& .nxpro-rail button [class*=\"text-\"]": {
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace",
      "fontSize": 9.5,
      "lineHeight": 1.3
    },
    "& .nxpro-rail::before": {
      "content": "\"TOOLS\"",
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace",
      "fontSize": 9,
      "padding": "0 0 8px",
      "letterSpacing": ".18em"
    },
    "& .nxpro-rail .nxm-entry-label": {
      "fontSize": 7,
      "padding": "0 0 10px",
      "textAlign": "center"
    },
    "& .nxpro-rail .nxm-entry-button": {
      "flexDirection": "column"
    },
    "& .nxpro-rail .nxm-entry-button span": {
      "fontSize": 9
    },
    "& .nxpro-right-rail button": {
      "borderRadius": 4,
      "minHeight": 44,
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace"
    },
    "& #dashboard-panel-home": {
      "padding": "4px 4px 4px"
    },
    "& #dashboard-panel-home > [data-slot=\"body\"]": {
      "borderRadius": 4,
      "boxShadow": "0 0 0 1px var(--nxpro-line)"
    },
    "& .nxpro-pane-label": {
      "borderRadius": 4,
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace",
      "fontSize": 12,
      "minHeight": 28,
      "boxShadow": "none",
      "border": "1px solid var(--nxpro-line)",
      "letterSpacing": ".04em"
    },
    "& .nxpro-timeline": {
      "borderRadius": 4,
      "padding": "9px 12px",
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace",
      "boxShadow": "none",
      "backdropFilter": "none"
    },
    "& [data-app-navbar] button, & [data-slot=\"header\"] button": {
      "borderRadius": 4,
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace"
    },
    "& [data-slot=\"title\"]": {
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace",
      "fontWeight": 500,
      "letterSpacing": ".05em"
    },
    "& [role=\"dialog\"][data-slot=\"content\"], & [role=\"menu\"], & [role=\"listbox\"]": {
      "borderRadius": 6,
      "border": "1px solid var(--nxpro-line)",
      "boxShadow": "none",
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace"
    },
    "& input:not([type=\"range\"]):not([type=\"checkbox\"]):not([type=\"radio\"]), & select, & textarea": {
      "borderRadius": 4,
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace"
    },
    "& .nxm-dialog, & .nxm-card, & .nxm-notes": {
      "borderRadius": 8,
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace"
    },
    "& .nxm-button, & .nxm-filter, & .nxm-search, & .nxm-dock-button": {
      "borderRadius": 4,
      "fontFamily": "\"Cascadia Code\",\"Consolas\",monospace"
    },
    "& .nxm-dialog": {
      "left": 88,
      "top": 66
    },
    "@media (max-width: 1000px)": {
      "& #dashboard-sidebar-toolbox[data-collapsed=\"true\"], & .nxpro-rail": {
        "width": 76,
        "minWidth": 76,
        "maxWidth": 76
      },
      "& .nxpro-rail": {
        "padding": "12px 6px"
      },
      "& .nxpro-rail button": {
        "width": 64,
        "minWidth": 64,
        "flexDirection": "column",
        "justifyContent": "center",
        "gap": 4
      },
      "& .nxpro-rail button [class*=\"text-\"]": {
        "fontSize": 10
      },
      "& .nxm-dialog": {
        "left": 88
      }
    },
    "@media (max-width: 750px)": {
      "& .nxm-dialog": {
        "left": 12,
        "top": 15
      }
    }
  },
  "palettes": {
    "BR": "; High Contrast — NUXRAD theme bundle\nProduct: BR\nUnits: dBZ\nScale: 1\nOffset: 0\n\nColor4: -20 0 0 0 0\nColor4: 0 70 90 110 45\nColor4: 15 70 130 150 160\nColor4: 20 0 255 100 255\nColor4: 30 0 150 50 255\nColor4: 35 255 255 0 255\nColor4: 45 255 130 0 255\nColor4: 50 255 35 35 255\nColor4: 60 255 0 220 255\nColor4: 70 255 255 255 255\nColor4: 80 80 215 255 255\n",
    "BV": "; Classic Radar — NUXRAD theme bundle\nProduct: BV\nUnits: m/s\nScale: 1\nOffset: 0\n\nColor4: -64 0 255 80 255\nColor4: -40 0 160 40 255\nColor4: -20 0 100 60 255\nColor4: -5 120 210 170 255\nColor4: 0 200 200 200 255\nColor4: 5 245 170 120 255\nColor4: 20 200 55 0 255\nColor4: 40 170 0 0 255\nColor4: 64 255 50 40 255\n"
  }
}